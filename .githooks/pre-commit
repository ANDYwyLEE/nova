#!/bin/sh
# Refuse to commit camera credentials or stream keys.
# Allowed placeholder passwords: password pass secret xxxx *** PASSWORD KEY YOUR-KEY $VAR
# Enable once per clone:  git config core.hooksPath .githooks
# Claude Code files stay local even when added with `git add -f`.
claude=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(\.claude/|CLAUDE(\.local)?\.md$|\.mcp\.json$)')
if [ -n "$claude" ]; then
    echo "pre-commit: Claude Code files are kept out of the repo:" >&2
    printf '%s\n' "$claude" | sed 's/^/  /' >&2
    echo "Unstage them with: git restore --staged <file>" >&2
    exit 1
fi
files=$(git diff --cached --name-only --diff-filter=AM | grep -v "^\.githooks/" | grep -v "^tests/")   # tests use synthetic credentials on purpose
[ -z "$files" ] && exit 0
added=$(git diff --cached -U0 -- $files | grep -E '^\+' | grep -vE '^\+\+\+')
ok='(password|pass|pw|pwd|secret|xxxx|\*\*\*|PASSWORD|KEY|YOUR-KEY|YOUR-STREAM-KEY|\$[A-Za-z_]+|%[A-Za-z_]+%)'
bad=$(printf '%s\n' "$added" | grep -oE "://[^/:@ \"']+:[^@/ \"']+@" | grep -vE "^://[^:]+:${ok}@\$")
bad2=$(printf '%s\n' "$added" | grep -oE "password=[^&\"' ]+" | grep -vE "^password=${ok}\$")
bad3=$(printf '%s\n' "$added" | grep -oE "live2/[A-Za-z0-9-]+" | grep -vE "^live2/(KEY|YOUR-KEY|YOUR-STREAM-KEY|xxxx[-x]*|\\$[A-Za-z_]+)\$")
if [ -n "$bad$bad2$bad3" ]; then
    echo "pre-commit: credentials found in the staged changes:" >&2
    printf '%s\n%s\n%s\n' "$bad" "$bad2" "$bad3" | sed '/^$/d; s/^/  /' >&2
    echo "Put real URLs in cameras.ini (git-ignored) and use placeholder passwords in committed files." >&2
    exit 1
fi
exit 0
