#!/bin/sh
# Refuse to commit camera credentials, stream keys or Nova's local state.
# Secrets are found with the patterns the logs are masked with (util.py, via find_secrets.py);
# placeholders are fine: password pass pw pwd secret xxxx *** PASSWORD KEY YOUR-KEY YOUR-STREAM-KEY $VAR
# Enable once per clone:  git config core.hooksPath .githooks
# Claude Code files stay local even when added with `git add -f`.
claude=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)(\.claude/|CLAUDE(\.local)?\.md$|\.mcp\.json$)')
if [ -n "$claude" ]; then
    echo "pre-commit: Claude Code files are kept out of the repo:" >&2
    printf '%s\n' "$claude" | sed 's/^/  /' >&2
    echo "Unstage them with: git restore --staged <file>" >&2
    exit 1
fi
local=$(git diff --cached --name-only --diff-filter=ACMR \
        | grep -E '(^|/)(cameras[^/]*\.ini|\.nova-pids\.json|\.uri_cache\.json|[^/]*\.log(\.1)?)$|^(logs|layouts)/' \
        | grep -vx 'cameras\.example\.ini')
if [ -n "$local" ]; then
    echo "pre-commit: local Nova state (cameras, logs, layouts, pids) is not committed:" >&2
    printf '%s\n' "$local" | sed 's/^/  /' >&2
    exit 1
fi
py=$(command -v python3 || command -v python)
if [ -z "$py" ]; then
    echo "pre-commit: no python found, secrets not checked" >&2
    exit 0
fi
# --no-renames: a moved file counts as added, so all of it is checked; names with spaces are fine
git -c core.quotePath=false diff --cached -U0 --no-renames --diff-filter=ACM | "$py" "$(git rev-parse --show-toplevel)/.githooks/find_secrets.py"
