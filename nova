#!/bin/sh
# Nova launcher:  ./nova start | record | run | stop | status | list      (./nova -h for help)
# Cameras and their passwords live in cameras.ini (git-ignored); cameras.example.ini is the template.
# Uses the project venv when there is one; cams.py does the work.
here=$(dirname "$(readlink -f "$0" 2>/dev/null || printf %s "$0")")   # works through a symlink (~/bin/nova)
if [ -x "$here/venv/bin/python" ]; then
    exec "$here/venv/bin/python" "$here/cams.py" "$@"
fi
exec python3 "$here/cams.py" "$@"
